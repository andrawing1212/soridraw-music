rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 2. Collection Rules

    // [Section Tags] Managed by admin, read by all
    match /section_tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // [Admin only] Live & Draft collections
    match /section_tags_live/{tagId} {
      allow read, write: if isAdmin();
    }

    match /section_tags_draft/{tagId} {
      allow read, write: if isAdmin();
    }

    // Users collection
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'free';
      allow update: if isAdmin() || (isOwner(uid) && request.resource.data.role == resource.data.role);
    }

    // Favorites collection
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // User recent songs
    match /user_recent_songs/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // User custom structures
    match /user_structures/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // User Suno Playlists
    match /user_playlists/{uid}/lists/{playlistId} {
      allow read, write: if isOwner(uid) || isAdmin();

      match /items/{itemId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Suno API Global Settings
    match /app_settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Suno API User Keys - Handled entirely by Firebase Functions
    match /user_api_keys/{uid} {
      allow read, write: if false;
    }

    // Suno API Tracks
    match /suno_tracks/{uid}/tracks/{trackId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if resource.data.isPublic == true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Suno public tracks for collectionGroup("tracks")
    match /{path=**}/tracks/{trackId} {
      allow read: if resource.data.isPublic == true;
    }

    // Suno API Shares
    match /suno_shares/{shareId} {
      function isValidShare(data) {
        return data.ownerUid is string &&
               data.ownerUid.size() <= 128 &&
               data.trackId is string &&
               data.title is string &&
               data.isPublic == true &&
               (!('audioUrl' in data) || data.audioUrl is string) &&
               (!('imageUrl' in data) || data.imageUrl is string) &&
               (!('taskId' in data) || data.taskId is string) &&
               (!('appliedKeywords' in data) || data.appliedKeywords is map) &&
               (!('requestPayload' in data) || data.requestPayload is map);
      }

      function isValidPrivateShareUpdate(data) {
        return data.ownerUid is string &&
               data.ownerUid.size() <= 128 &&
               data.trackId is string &&
               data.title is string &&
               data.isPublic == false;
      }

      allow read: if resource.data.isPublic == true ||
                   isOwner(resource.data.ownerUid) ||
                   isAdmin();

      allow create: if isAuthenticated() &&
                     request.resource.data.ownerUid == request.auth.uid &&
                     isValidShare(request.resource.data);

      allow update: if (isOwner(resource.data.ownerUid) || isAdmin()) &&
                    request.resource.data.ownerUid == resource.data.ownerUid &&
                    (isValidShare(request.resource.data) || isValidPrivateShareUpdate(request.resource.data));

      allow delete: if isOwner(resource.data.ownerUid) || isAdmin();
    }

    // Music Note Shares
    match /music_note_shares/{shareId} {
      function isValidMusicNoteShare(data) {
        return data.ownerUid is string &&
               data.ownerUid.size() <= 128 &&
               data.title is string &&
               data.isPublic == true &&
               data.songs is list &&
               data.songs.size() > 0 &&
               data.songs.size() <= 50;
      }

      allow read: if resource.data.isPublic == true ||
                   isOwner(resource.data.ownerUid) ||
                   isAdmin();

      allow create: if isAuthenticated() &&
                     request.resource.data.ownerUid == request.auth.uid &&
                     isValidMusicNoteShare(request.resource.data);

      allow update: if (isOwner(resource.data.ownerUid) || isAdmin()) &&
                    request.resource.data.ownerUid == resource.data.ownerUid &&
                    isValidMusicNoteShare(request.resource.data);

      allow delete: if isOwner(resource.data.ownerUid) || isAdmin();
    }

    // Playlist Likes
    match /playlist_like_counts/{trackGlobalId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /playlist_likes/{trackGlobalId}/users/{uid} {
      allow read: if isAuthenticated();
      allow create, delete: if isOwner(uid);
      allow update: if false;
    }

    // 3. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}