rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 2. Collection Rules

    // [Section Tags] Managed by admin, read by all
    match /section_tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // [Admin only] Live & Draft collections
    match /section_tags_live/{tagId} {
      allow read, write: if isAdmin();
    }

    match /section_tags_draft/{tagId} {
      allow read, write: if isAdmin();
    }

    // Users collection
    // Membership, payment and account-control fields are server/admin authority only.
    // Client-maintained counters remain UI statistics and must never be trusted for entitlement checks.
    match /users/{uid} {
      function isValidSelfCreate() {
        return request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'providerIds',
          'createdAt', 'lastLoginAt', 'lastSeenAt', 'lastLogoutAt', 'isOnline',
          'role', 'accountStatus', 'paymentStatus', 'favoriteCount', 'songGeneratedCount'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'free' &&
        request.resource.data.accountStatus == 'active' &&
        request.resource.data.paymentStatus == 'none' &&
        request.resource.data.favoriteCount == 0 &&
        request.resource.data.songGeneratedCount == 0;
      }

      function isValidSelfUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'providerIds',
          'lastLoginAt', 'lastSeenAt', 'lastLogoutAt', 'isOnline',
          'nickname', 'updatedAt', 'lyricClicheGuard',
          'favoriteCount', 'songGeneratedCount',
          'favoriteSyncSignal', 'favoriteSyncSignalUpdatedAt'
        ]) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == uid);
      }

      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid) && isValidSelfCreate();
      allow update: if isAdmin() || (isOwner(uid) && isValidSelfUpdate());
    }

    // Favorites collection
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // User recent songs
    match /user_recent_songs/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // User custom structures
    match /user_structures/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // User Suno Playlists
    match /user_playlists/{uid}/lists/{playlistId} {
      allow read, write: if isOwner(uid) || isAdmin();

      match /items/{itemId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // App Settings
    // navigation_visibility is read by the app so the public menu can react to admin toggles.
    // Writes remain admin-only.
    match /app_settings/{docId} {
      allow read: if docId in ['navigation_visibility', 'lyric_cliche_guard'] || isAdmin();
      allow write: if isAdmin();
    }

    // Suno API User Keys - Handled entirely by Firebase Functions
    match /user_api_keys/{uid} {
      allow read, write: if false;
    }

    // Server-side Gemini abuse guard. Never exposed to clients.
    match /gemini_request_guards/{uid} {
      allow read, write: if false;
    }


    // Suno API Tracks
    match /suno_tracks/{uid}/tracks/{trackId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if resource.data.isPublic == true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Suno public tracks for collectionGroup("tracks")
    match /{path=**}/tracks/{trackId} {
      allow read: if resource.data.isPublic == true;
    }

    // Suno API Shares
    match /suno_shares/{shareId} {
      function isValidShare(data) {
        return data.ownerUid is string &&
               data.ownerUid.size() <= 128 &&
               data.trackId is string &&
               data.title is string &&
               data.isPublic == true &&
               (!('audioUrl' in data) || data.audioUrl is string) &&
               (!('imageUrl' in data) || data.imageUrl is string) &&
               (!('taskId' in data) || data.taskId is string) &&
               (!('appliedKeywords' in data) || data.appliedKeywords is map) &&
               (!('requestPayload' in data) || data.requestPayload is map);
      }

      function isValidPrivateShareUpdate(data) {
        return data.ownerUid is string &&
               data.ownerUid.size() <= 128 &&
               data.trackId is string &&
               data.title is string &&
               data.isPublic == false;
      }

      allow read: if resource.data.isPublic == true ||
                   isOwner(resource.data.ownerUid) ||
                   isAdmin();

      allow create: if isAuthenticated() &&
                     request.resource.data.ownerUid == request.auth.uid &&
                     isValidShare(request.resource.data);

      allow update: if (isOwner(resource.data.ownerUid) || isAdmin()) &&
                    request.resource.data.ownerUid == resource.data.ownerUid &&
                    (isValidShare(request.resource.data) || isValidPrivateShareUpdate(request.resource.data));

      allow delete: if isOwner(resource.data.ownerUid) || isAdmin();
    }

    // Music Note Shares
    match /music_note_shares/{shareId} {
      function isValidMusicNoteShare(data) {
        return data.ownerUid is string &&
               data.ownerUid.size() <= 128 &&
               data.title is string &&
               data.isPublic is bool &&
               data.songs is list &&
               data.songs.size() > 0 &&
               data.songs.size() <= 50;
      }

      allow read: if resource.data.isPublic == true ||
                   isOwner(resource.data.ownerUid) ||
                   isAdmin();

      allow create: if isAuthenticated() &&
                     request.resource.data.ownerUid == request.auth.uid &&
                     isValidMusicNoteShare(request.resource.data);

      allow update: if (isOwner(resource.data.ownerUid) || isAdmin()) &&
                    request.resource.data.ownerUid == resource.data.ownerUid &&
                    isValidMusicNoteShare(request.resource.data);

      allow delete: if isOwner(resource.data.ownerUid) || isAdmin();
    }

    // Playlist Likes
    match /playlist_like_counts/{trackGlobalId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /playlist_likes/{trackGlobalId}/users/{uid} {
      allow read: if isAuthenticated();
      allow create, delete: if isOwner(uid);
      allow update: if false;
    }

    // 3. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}