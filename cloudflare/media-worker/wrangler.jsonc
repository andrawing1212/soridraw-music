{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soridraw-media-preview",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "soridraw-app-866a5",
    "FIREBASE_PROJECT_NUMBER": "91309780603",
    "FIREBASE_WEB_APP_ID": "1:91309780603:web:cde703895e2cf31ecffcde",
    "ARCHIVE_MIN_AGE_DAYS": "14",
    "SIGNED_URL_TTL_SECONDS": "1800",
    "ALLOWED_ORIGINS": "https://preview.soridraw.com,https://soridraw-preview.web.app,https://soridraw-preview.firebaseapp.com"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "soridraw-media-preview"
    }
  ]
}
